<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- DPDPA / CERT-In: no plaintext HTTP anywhere. All MITRA traffic is HTTPS. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>